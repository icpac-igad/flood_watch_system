# GHCR Image Configuration for Staging
# Copy to .env.ghcr on staging server and source before docker compose

# GitHub Container Registry images (auto-updated by CI/CD)
# Replace YOUR_GITHUB_ORG with your actual GitHub org/username (lowercase)
WEB_IMAGE_NAME=ghcr.io/YOUR_GITHUB_ORG/eafw-cms:latest
MAPVIEWER_IMAGE_NAME=ghcr.io/YOUR_GITHUB_ORG/eafw-mapviewer:latest
MAPSERVER_IMAGE_NAME=ghcr.io/YOUR_GITHUB_ORG/eafw-mapserver:latest
MAPCACHE_IMAGE_NAME=ghcr.io/YOUR_GITHUB_ORG/eafw-mapcache:latest
JOBS_IMAGE_NAME=ghcr.io/YOUR_GITHUB_ORG/eafw-jobs:latest
