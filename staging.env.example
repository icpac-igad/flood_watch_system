# ===========================================
# EAFW FloodWatch - Staging Environment
# Copy to staging server as: .env
# Secrets are injected by CI/CD from GitHub Secrets
# ===========================================

# Host Configuration
HOST_IP=0.0.0.0
TIME_ZONE=Africa/Nairobi
RESTART_POLICY=always

# ===========================================
# PORTS (90xx series for EAFW)
# ===========================================
DB_HOST_PORT=9060
PGB_HOST_PORT=9061
CACHE_HOST_PORT=9062
WEB_HOST_PORT=9063
UI_HOST_PORT=9064
MS_HOST_PORT=9065
MC_HOST_PORT=9066
TILESERV_HOST_PORT=9067
CMS_HOST_PORT=9068
API_HOST_PORT=9069

# ===========================================
# DATABASE
# ===========================================
CMS_DB_NAME=eafw_db
CMS_DB_USER=eafw_user
CMS_DB_PASSWORD=CHANGE_ME
PG_VERSION=16-3.4
PG_MAX_CONNECTIONS=120

# PgBouncer
PGB_HOST=eafw_pgbouncer
PGB_PORT=6432

# ===========================================
# DJANGO / CMS
# ===========================================
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_50
CMS_DEBUG=False
CMS_SITE_NAME=East Africa Flood Watch
ALLOWED_HOSTS=197.254.1.10,10.10.1.13,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://197.254.1.10,http://197.254.1.10:9068,http://10.10.1.13:9068
CMS_BASE_URL=http://197.254.1.10:9068
ADMIN_URL_PATH=cms-admin
DJANGO_SETTINGS_MODULE=geomanagerweb.settings.production
CMS_NUM_OF_WORKERS=4

# ===========================================
# MAPSERVER / MAPCACHE
# ===========================================
MS_SERVICE_URL=http://197.254.1.10:9065/mapserver/
MC_SERVICE_URL=http://197.254.1.10:9066/mapcache/
WGS84_GRID_EXTENTS=21 -12 52 23
WEB_GRID_EXTENTS=2337709 -1329087 5792092 2632018

# ===========================================
# GHCR IMAGES (auto-updated by CI/CD)
# ===========================================
WEB_IMAGE_NAME=ghcr.io/icpac-igad/eafw-cms:latest
MAPVIEWER_IMAGE_NAME=ghcr.io/icpac-igad/eafw-mapviewer:latest
MAPSERVER_IMAGE_NAME=ghcr.io/icpac-igad/eafw-mapserver:latest
MAPCACHE_IMAGE_NAME=ghcr.io/icpac-igad/eafw-mapcache:latest
API_IMAGE_NAME=ghcr.io/icpac-igad/eafw-api:latest
JOBS_IMAGE_NAME=ghcr.io/icpac-igad/eafw-jobs:latest

# ===========================================
# DATA SYNC (FloodProofs SFTP)
# ===========================================
FLOODPROOFS_SFTP_HOST=197.254.113.173
FLOODPROOFS_SFTP_PORT=22
FLOODPROOFS_SFTP_USER=floodproofs
FLOODPROOFS_SFTP_PASSWORD=CHANGE_ME

# Google Drive sync (optional)
DRIVE_FOLDER_ID=
SYNC_SOURCE=sftp
SYNC_INTERVAL=21600
SYNC_DAYS=7
