######## EAFW FLOODWATCH - STAGING ENVIRONMENT ########
# Used by docker-compose.staging.yml
# Secrets (CMS_DB_PASSWORD, SECRET_KEY, SFTP_PASSWORD, etc.)
# are injected by the CI/CD deploy script from GitHub Secrets.

######## DATABASE ########
CMS_DB_USER=eafw_user
CMS_DB_NAME=eafw_db
CMS_DB_PASSWORD=INJECTED_BY_CI

######## CONTAINER NAMES ########
DB_CNTR_NAME=eafw-pgdb
PGBOUNCER_CNTR_NAME=eafw-pgbouncer
MEMCACHED_CNTR_NAME=eafw-memcached
WEB_CNTR_NAME=eafw-cms
MAPVIEWER_CNTR_NAME=eafw-mapviewer
MAPSERVER_CNTR_NAME=eafw-mapserver
MAPCACHE_CNTR_NAME=eafw-mapcache
TILESERV_CNTR_NAME=eafw-tileserv
NGINX_CNTR_NAME=eafw-nginx
API_CNTR_NAME=eafw-api
JOBS_CNTR_NAME=eafw-jobs

######## HOST / NETWORK ########
HOST_IP=0.0.0.0
RESTART_POLICY=always

DB_HOST_PORT=9060
PGB_HOST_PORT=9061
CACHE_HOST_PORT=9062
WEB_HOST_PORT=9063
UI_HOST_PORT=9064
MS_HOST_PORT=9065
MC_HOST_PORT=9066
TILESERV_HOST_PORT=9067
CMS_HOST_PORT=9068
API_HOST_PORT=9069

######## CMS (GEOMANAGER) ########
CMS_DEBUG=False
CMS_SITE_NAME=East Africa Flood Watch
ADMIN_URL_PATH=cms-admin
TIME_ZONE=Africa/Nairobi
SECRET_KEY=INJECTED_BY_CI
ALLOWED_HOSTS=41.139.151.242,floodwatch.icpac.net,10.10.1.13,0.0.0.0,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://41.139.151.242,http://41.139.151.242:9068,http://10.10.1.13,http://10.10.1.13:9068,http://127.0.0.1,http://localhost,https://floodwatch.icpac.net,http://floodwatch.icpac.net
CMS_BASE_URL=http://41.139.151.242:9068
FORCE_SCRIPT_NAME=
CMS_DEFAULT_LANGUAGE_CODE=en
DJANGO_SETTINGS_MODULE=geomanagerweb.settings.production
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CMS_NUM_OF_WORKERS=4

######## MAPVIEWER ########
MAPVIEWER_CMS_API=/api
MAPVIEWER_SERVER_URL=http://eafw_mapviewer:3000
MAPVIEWER_BASE_PATH=/
MAPVIEWER_ASSET_PREFIX=
ADMIN_BOUNDARY_API=/api/v1/boundaries/admin-boundaries/

######## MAPSERVER / MAPCACHE ########
MS_MAPFILES_VOLUME=./data/mapfiles
MS_SERVICE_URL=http://41.139.151.242:9065/mapserver/
MC_SERVICE_URL=http://41.139.151.242:9066/mapcache/

######## FLOODPROOFS SFTP (used by jobs) ########
FLOODPROOFS_SFTP_HOST=change-me
FLOODPROOFS_SFTP_PORT=22
FLOODPROOFS_SFTP_USER=change-me
FLOODPROOFS_SFTP_PASSWORD=INJECTED_BY_CI
FLOODPROOFS_REMOTE_DIR=/home/floodproofs/merged_forecasts

######## ENSEMBLE FTP (used by jobs) ########
ENSEMBLE_FTP_HOST=ftp.example.org
ENSEMBLE_FTP_PORT=21
ENSEMBLE_FTP_USER=change-me
ENSEMBLE_FTP_PASSWORD=INJECTED_BY_CI
ENSEMBLE_REMOTE_DIR=/ftproot/output/Combined

######## SFTP LEGACY ########
SFTP_HOST=change-me
SFTP_PORT=22
SFTP_USERNAME=change-me
SFTP_PASSWORD=INJECTED_BY_CI

######## GOOGLE DRIVE / SYNC ########
DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=/opt/credentials/google-credentials.json
SYNC_SOURCE=drive
SYNC_INTERVAL=21600
SYNC_DAYS=7

######## GOOGLE FLOOD API (used by jobs) ########
FLOODS_API_KEY=
GOOGLE_FLOOD_REGION_CODES=ET,KE,UG,SD,SS,RW,SO,DJ,ER,TZ,BI
GOOGLE_FLOOD_PAGE_SIZE=20000
GOOGLE_FLOOD_STATUS_CHUNK_SIZE=500
GOOGLE_FLOOD_MODEL_CHUNK_SIZE=200
GOOGLE_FLOOD_FORECAST_CHUNK_SIZE=200
GOOGLE_FLOOD_ISSUED_LOOKBACK_DAYS=7
GOOGLE_FLOOD_INCLUDE_NON_QUALITY_VERIFIED=true
GOOGLE_FLOOD_INCLUDE_GAUGES_WITHOUT_HYDRO_MODEL=true
GOOGLE_FLOOD_REQUEST_TIMEOUT_SECONDS=120
GOOGLE_FLOOD_MAX_RETRIES=4
GOOGLE_FLOOD_BASE_BACKOFF_SECONDS=1.0
