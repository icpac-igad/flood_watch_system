# STAC Collection & Item Loader
# One-shot container: loads initial STAC collections and converts rasters to COGs.
# Usage: docker compose --profile init run --rm eafw_stac_loader

FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        gdal-bin \
        libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    pypgstac[psycopg]==0.9.5 \
    "psycopg[binary]" \
    rasterio \
    rio-cogeo \
    pystac \
    click \
    httpx \
    shapely

WORKDIR /opt

COPY eafw_stac/collections/ /opt/collections/
COPY eafw_stac/items/ /opt/items/
COPY eafw_stac/scripts/ /opt/scripts/

# Make scripts executable
RUN chmod +x /opt/scripts/*.sh 2>/dev/null || true

CMD ["python", "/opt/scripts/pipeline.py", "bootstrap"]
