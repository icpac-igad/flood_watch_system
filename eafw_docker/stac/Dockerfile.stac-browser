# STAC Browser — custom build for FloodWatch
# Builds the Radiant Earth STAC Browser with FloodWatch STAC API endpoint baked in.

FROM node:20-alpine AS builder

ARG BASE_PATH=/stac-browser/
ARG STAC_API_URL=/stac-browser/api/

RUN apk add --no-cache git

RUN git clone --depth 1 https://github.com/radiantearth/stac-browser.git /app

WORKDIR /app

RUN npm install

# Build with catalog URL and title baked in, with base path for sub-path hosting
RUN CATALOG_URL=${STAC_API_URL} \
    SB_catalogTitle="FloodWatch STAC API" \
    npx vite build --base ${BASE_PATH}

# --- Production stage ---
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY stac-browser-nginx.conf /etc/nginx/conf.d/default.conf
COPY floodwatch-theme.css /usr/share/nginx/html/floodwatch-theme.css
COPY icpac-logo.png /usr/share/nginx/html/icpac-logo.png

# Enable runtime-config.js: replace the commented-out line with a blocking script
# that loads BEFORE the module scripts (no defer, no module type)
RUN sed -i 's|<!-- <script defer="defer" src="/runtime-config.js"></script> -->|<script src="/stac-browser/runtime-config.js"></script>|' \
    /usr/share/nginx/html/index.html

# Inject FloodWatch visual theme override
RUN sed -i 's|</head>|  <link rel="stylesheet" href="/stac-browser/floodwatch-theme.css?v=20260224g">\
</head>|' /usr/share/nginx/html/index.html

# Write default runtime config (can be overridden by entrypoint)
ARG STAC_API_URL=/stac-browser/api/
RUN printf 'window.STAC_BROWSER_CONFIG = {\n  catalogUrl: "%s",\n  catalogTitle: "FloodWatch STAC API",\n  catalogImage: "/stac-browser/icpac-logo.png",\n  pathPrefix: "/stac-browser/",\n  allowExternalAccess: true,\n  allowedDomains: ["*"]\n};\n' "${STAC_API_URL}" \
    > /usr/share/nginx/html/runtime-config.js

# Security: run as non-root
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

EXPOSE 8085

CMD ["nginx", "-g", "daemon off;"]
