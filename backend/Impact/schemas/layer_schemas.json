    "hydrological_data": {
      "model": "IBEWv2HydrologicalData",
      "description": "IBEW v2 Hydrological Data (return periods)",
      "geometry_type": "linestring",
      "file_patterns": ["*returnperiod*", "*return_period*"],
      "field_mapping": {
        "rp": {"type": "FloatField", "ogr_field": "rp", "required": true},
        "log_ups": {"type": "FloatField", "ogr_field": "log_ups", "required": false},
        "geometry": "geometry.linestring"
      }
    }
  },
  "raster_schemas": {
    "alert_level_raster": {
      "model": "AlertLevelRaster",
      "description": "Alert level raster data (group1, group2, group4)",
      "file_patterns": ["*alert_level*", "*group1*", "*group2*", "*group4*"],
      "expected_values": [0, 1, 2, 3, 4],
      "band_analysis": true,
      "cog_conversion": true
    },
    "flood_hazard_raster": {
      "model": "FloodHazardMapRaster", 
      "description": "Flood hazard map raster data (inundation maps)",
      "file_patterns": ["*flood_hazard_map*", "*inundation*"],
      "expected_values": [0, 1],
      "band_analysis": true,
      "cog_conversion": true
    }
  },
  "data_sources": {
    "ibew_v1_directory": "/home/koros/IGAD-ICPAC/Projects/FloodWatch/code/flood_watch_system/Impact_forecast",
    "ibew_v2_directory": "/home/koros/IGAD-ICPAC/Projects/FloodWatch/code/flood_watch_system/merged/2025",
    "raster_directory": "/home/koros/IGAD-ICPAC/Projects/FloodWatch/code/flood_watch_system/Impact_forecast"
  },
  "validation_rules": {
    "date_extraction": {
      "ibew_v1": {
        "pattern": "YYYY/MM/DD/HH",
        "path_based": true
      },
      "ibew_v2": {
        "pattern": "YYYYMMDDHHMM", 
        "filename_based": true
      },
      "raster": {
        "pattern": "YYYY/MM/DD/HH",
        "path_based": true
      }
    },
    "required_fields": {
      "administrative": ["name_0", "name_1"],
      "temporal": ["data_date"],
      "spatial": ["geom", "geometry"]
    }
  },
  "field_type_mapping": {
    "CharField": "string",
    "IntegerField": "integer", 
    "FloatField": "float",
    "DateField": "date",
    "DateTimeField": "datetime",
    "JSONField": "json",
    "BooleanField": "boolean"
  }
}