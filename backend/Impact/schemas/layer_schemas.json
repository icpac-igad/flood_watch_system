{
  "metadata": {
    "version": "1.0",
    "description": "FloodWatch Layer Schema Configuration",
    "last_updated": "2025-09-07",
    "note": "Centralized schema definitions for all flood impact layers"
  },
  "common_fields": {
    "administrative": {
      "code_adm": {"type": "CharField", "max_length": 80, "ogr_field": "CODE_ADM", "required": false},
      "gid_0": {"type": "CharField", "max_length": 80, "ogr_field": "GID_0", "required": true},
      "name_0": {"type": "CharField", "max_length": 80, "ogr_field": "NAME_0", "required": true},
      "name_1": {"type": "CharField", "max_length": 80, "ogr_field": "NAME_1", "required": true},
      "engtype_1": {"type": "CharField", "max_length": 80, "ogr_field": "ENGTYPE_1", "required": false},
      "lack_cc": {"type": "FloatField", "ogr_field": "LACK_CC", "required": false},
      "cod": {"type": "CharField", "max_length": 80, "ogr_field": "COD", "required": false}
    },
    "impact_basic": {
      "pop_tot": {"type": "IntegerField", "ogr_field": "pop_tot", "required": false, "default": 0},
      "flood_tot": {"type": "FloatField", "ogr_field": "flood_tot", "required": false, "default": 0}
    },
    "geometry": {
      "polygon": {"type": "MULTIPOLYGON", "ogr_field": "MULTIPOLYGON"},
      "linestring": {"type": "MULTILINESTRING", "ogr_field": "MULTILINESTRING"},
      "point": {"type": "POINT", "ogr_field": "POINT"}
    }
  },
  "ibew_v1_schemas": {
    "impact_forecast_population": {
      "model": "ImpactForecastPopulation",
      "description": "IBEW v1 Population Impact Forecast",
      "geometry_type": "polygon",
      "file_patterns": ["*population*", "*pop*"],
      "field_mapping": {
        "gid_0": "administrative.gid_0",
        "name_0": "administrative.name_0", 
        "name_1": "administrative.name_1",
        "engtype_1": "administrative.engtype_1",
        "lack_cc": "administrative.lack_cc",
        "cod": "administrative.cod",
        "stock": {"type": "FloatField", "ogr_field": "stock", "required": false, "default": 0},
        "flood_tot": {"type": "FloatField", "ogr_field": "flood_tot", "required": false, "default": 0},
        "flood_perc": {"type": "FloatField", "ogr_field": "flood_perc", "required": false, "default": 0},
        "flood_leve": {"type": "FloatField", "ogr_field": "flood_leve", "required": false},
        "geom": "geometry.polygon"
      }
    },
