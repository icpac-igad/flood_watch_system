  "ibew_v2_schemas": {
    "infrastructure_impact": {
      "model": "IBEWv2InfrastructureImpact",
      "description": "IBEW v2 Infrastructure Impact (built, services, roads)",
      "geometry_type": "polygon",
      "file_patterns": ["*built*", "*services*", "*roads*"],
      "field_mapping": {
        "code_adm": "administrative.code_adm",
        "gid_0": "administrative.gid_0", 
        "name_0": "administrative.name_0",
        "name_1": "administrative.name_1",
        "engtype_1": "administrative.engtype_1",
        "lack_cc": "administrative.lack_cc",
        "cod": "administrative.cod",
        "pop_tot": "impact_basic.pop_tot",
        "flood_tot": "impact_basic.flood_tot",
        "tot_gov": {"type": "FloatField", "ogr_field": "tot_gov", "required": false},
        "tot_ind": {"type": "FloatField", "ogr_field": "tot_ind", "required": false},
        "tot_res": {"type": "FloatField", "ogr_field": "tot_res", "required": false},
        "tot_reslow": {"type": "FloatField", "ogr_field": "tot_resLow", "required": false},
        "tot_resmh": {"type": "FloatField", "ogr_field": "tot_resMH", "required": false},
        "tot_serv": {"type": "FloatField", "ogr_field": "tot_serv", "required": false},
        "geom": "geometry.polygon"
      }
    },
    "population_impact": {
      "model": "IBEWv2PopulationImpact", 
      "description": "IBEW v2 Population Impact (affected, displaced, demographics)",
      "geometry_type": "polygon",
      "file_patterns": ["*pop*", "*displaced*"],
      "field_mapping": {
        "code_adm": "administrative.code_adm",
        "gid_0": "administrative.gid_0",
        "name_0": "administrative.name_0", 
        "name_1": "administrative.name_1",
        "engtype_1": "administrative.engtype_1",
        "lack_cc": "administrative.lack_cc",
        "cod": "administrative.cod",
        "pop_tot": "impact_basic.pop_tot",
        "flood_tot": "impact_basic.flood_tot",
        "tot_crop": {"type": "FloatField", "ogr_field": "tot_crop", "required": false},
        "tot_graze": {"type": "FloatField", "ogr_field": "tot_graze", "required": false},
        "tot_ind": {"type": "FloatField", "ogr_field": "tot_ind", "required": false},
        "tot_res": {"type": "FloatField", "ogr_field": "tot_res", "required": false},
        "tot_serv": {"type": "FloatField", "ogr_field": "tot_serv", "required": false},
        "flood_perc": {"type": "FloatField", "ogr_field": "flood_perc", "required": false},
        "flood_clas": {"type": "CharField", "max_length": 20, "ogr_field": "flood_clas", "required": false},
        "geom": "geometry.polygon"
      }
    },
