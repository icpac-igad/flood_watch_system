# Root dockerignore - exclude unnecessary files from build context

# Git
.git
.gitignore

# Data directories
data/
*.tif
*.nc
*.geojson
*.shp
*.dbf
*.prj

# Node modules (mapviewer has its own .dockerignore)
**/node_modules
**/.next

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache

# Virtual environments
**/.venv
**/venv
**/env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker volumes (local development data)
**/docker/volumes
**/volumes

# Backup and temp files
backup/
*.bak
*.tmp
tmp/

# Documentation (not needed in build)
*.md
!README.md

# Media files (mounted at runtime)
**/media/

# Static files (collected at runtime) - Django only, not React wrappers
eafw_cms/static/
eafw_cms/staticfiles/
**/staticfiles/

# Cache
**/cache/
**/.cache/
