# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.claude/
*CLAUDE.md
# Virtual environments
.venv/
venv/
ENV/

# Node
node_modules/
.next/

# IDE
.idea/
.vscode/
*.swp

# Environment files with secrets
.env
.env.local
.env.staging
.env.production
staging.env
production.env
!.env.sample
!.env.example

# Database data volumes
pgdata/
data/pgdata/

# Media uploads
media/

# Logs
*.log
logs/

# SQL data files (large)
backup.sql
backups/
*.sql.gz
**/ingest_*.sql
**/backup*.sql
**/dump*.sql
**/export*.sql

# DB init data — track compressed init files (needed for fresh deploys)
# Only ignore ad-hoc dump files, not the init data
!eafw_docker/db-init/*.sql.gz

# Large GeoJSON files
*.geojson

# Shapefile and QGIS sidecar artifacts (large binary data; keep out of git)
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qmd

# OS files
.DS_Store
Thumbs.db

# Docker volume data
**/volumes/

# Credentials (secrets)
credentials/
*.pem
*.key
google-credentials.json

# Test coverage
htmlcov/
.coverage
.pytest_cache/

# Cache
.cache/
**/cache/
**/.cache/

# Runtime data (root level only, not src/data)
/data
eafw_jobs/data/
eafw_jobs/logs/

# Raster data (COGs and source TIFFs — large binary files)
raster-data/cogs/**/*.tif
raster-data/cogs/**/*.tiff
raster-data/cogs/**/*.json
raster-data/source/**/*.tif
raster-data/source/**/*.tiff

# Backup files (large)
*.dump
*.tar.gz
*backup*.sh
backup-*.sh

# MapServer generated files
eafw_docker/mapserver/mapfiles/symbols/

# MkDocs build output
site/
