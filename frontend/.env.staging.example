# Same-origin proxies (configure Nginx as in deploy/nginx/README.md)
VITE_WMS_PROXY_BASE=/wms
VITE_MAPCACHE_PROXY_BASE=/mapcache
VITE_MAPSERVER_ASSETS_BASE=/assets

# Optional: keep API same-origin via Nginx
VITE_API_URL=http://197.254.1.10:8094/api

# If proxies are used, you can omit cross-origin endpoints below
# VITE_MAPSERVER_URL=
# VITE_MAPCACHE_WMS_URL=
# VITE_MAPCACHE_TMS_URL=
