{
  "metadata": {
    "title": "East Africa Flood Watch Map Service",
    "abstract": "East Africa Flood Watch System Tile Cache Service",
    "defaultlanguage": "eng",
    "fees": "No fees for this service",
    "accessconstraints": "No access restrictions",
    "providername": "ICPAC Climate Prediction and Applications Centre",
    "providerurl": "https://www.icpac.net/",
    "contactorganization": "disaster-risk-management@igad.int",
    "contactname": "ICPAC Disaster Risk Management Programme",
    "contactcountry": "Kenya",
    "contactcity": "Nairobi",
    "url": "${SERVICE_URL}"
  },
  "global_url_definitions": {
    "eafw_mapserver": "${SOURCE_URL}"
  },
  "global_options": {
    "num_threads": "${NUM_THREADS}",
    "log_level": "${LOG_LEVEL}",
    "threaded_fetching": "${THREADED_FETCHING}",
    "errors": "${ERROR_REPORTING}",
    "default_format": "png_rgba"
  },
  "caches": [
    {
      "name": "disk_cache",
      "type": "disk",
      "layout": "template",
      "options": {
        "template": "${TILES_DIR}/{tileset}/{grid}/{dim}/{z}/{x}/{y}.{ext}",
        "max_usage": "20G"
      }
    }
  ],
  "locker": {
    "type": "disk",
    "directory": "/tmp",
    "timeout": 300,
    "retry": 0.1
  },
  "connection_pool": {
    "max_connections": 1024,
    "time_to_live_us": 1800000
  },
  "image_formats": [
    {
      "name": "png_fast",
      "type": "PNG",
      "details": {
        "compression": "fast",
        "color": "256"
      }
    },
    {
      "name": "png_rgba",
      "type": "PNG",
      "details": {
        "compression": "fast",
        "color": "truecolor"
      }
    },
    {
      "name": "true_jpeg",
      "type": "JPEG",
      "details": {
        "color": "truecolor",
        "quality": 75,
        "photometric": "RGB",
        "optimize": true
      }
    }
  ],
  "sources": [
    {
      "name": "daily_hmc_alert_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "daily_hmc_alert",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "flood_extent_rp25_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "flood_extent_rp25",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "flood_extent_rp100_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "flood_extent_rp100",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "asap_cropland_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "asap_cropland",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "asap_rangeland_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "asap_rangeland",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "wrf_daily_rainfall_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "wrf_daily_rainfall",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "wrf_extreme_heavy_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "wrf_extreme_heavy",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "wrf_extreme_very_heavy_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "wrf_extreme_very_heavy",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "wrf_extreme_extremely_heavy_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "wrf_extreme_extremely_heavy",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "admin0_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "admin0_fill,admin0_outline",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "admin1_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "admin1_outline",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "admin2_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "admin2_outline",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    },
    {
      "name": "landscan_population_source",
      "type": "wms",
      "url_ref": "eafw_mapserver",
      "layers": "landscan_population",
      "format": "image/png",
      "transparent": "true",
      "connection_timeout": 30,
      "timeout": 300
    }
  ],
  "tileset_attrs": {
    "grids": {
      "WGS84": {
        "restricted_extent": "${WGS84_GRID_EXTENTS}",
        "minzoom": "4",
        "maxzoom": "14"
      },
      "GoogleMapsCompatible": {
        "restricted_extent": "${WEB_GRID_EXTENTS}",
        "minzoom": "4",
        "maxzoom": "14"
      }
    },
    "cache": "disk_cache",
    "metatile": "5 5",
    "metabuffer": 10,
    "expires": "${TILESET_EXPIRE_SEC}",
    "dimensions": [
      {
        "name": "time",
        "type": "regex",
        "default": "2026-02-21",
        "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      {
        "name": "scope",
        "type": "regex",
        "default": "all",
        "regex": "^(all|project|whca)?$"
      },
      {
        "name": "project_countries",
        "type": "regex",
        "default": "__none__",
        "regex": "^(__none__|[A-Za-z ,'-]*)$"
      },
      {
        "name": "country_name",
        "type": "regex",
        "default": "__none__",
        "regex": "^(__none__|[A-Za-z .,'-]*)$"
      },
      {
        "name": "region_name",
        "type": "regex",
        "default": "__none__",
        "regex": "^(__none__|[A-Za-z .,'-]*)$"
      },
      {
        "name": "district_name",
        "type": "regex",
        "default": "__none__",
        "regex": "^(__none__|[A-Za-z .,'-]*)$"
      }
    ]
  },
  "tilesets": [
    {
      "name": "admin0_boundaries",
      "source": "admin0_source",
      "format_ref": "png_rgba",
      "no_dimensions": true,
      "metadata": {
        "title": "Admin Level 0 Country Boundaries"
      }
    },
    {
      "name": "admin1_boundaries",
      "source": "admin1_source",
      "format_ref": "png_rgba",
      "no_dimensions": true,
      "metadata": {
        "title": "Admin Level 1 Sub-National Boundaries"
      }
    },
    {
      "name": "admin2_boundaries",
      "source": "admin2_source",
      "format_ref": "png_rgba",
      "no_dimensions": true,
      "metadata": {
        "title": "Admin Level 2 District Boundaries"
      }
    },
    {
      "name": "daily_hmc_alert",
      "source": "daily_hmc_alert_source",
      "format_ref": "png_fast",
      "metatile": "2 2",
      "metadata": {
        "title": "Daily HMC Flood Alert Tiles"
      }
    },
    {
      "name": "flood_extent_rp25",
      "source": "flood_extent_rp25_source",
      "format_ref": "png_rgba",
      "own_dimensions_only": true,
      "dimensions": [
        {
          "name": "scope",
          "type": "regex",
          "default": "all",
          "regex": "^(all|project|whca)?$"
        },
        {
          "name": "project_countries",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z ,'-]*)$"
        },
        {
          "name": "country_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "region_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "district_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        }
      ],
      "metadata": {
        "title": "Flood Extent 25-Year Return Period Tiles"
      }
    },
    {
      "name": "flood_extent_rp100",
      "source": "flood_extent_rp100_source",
      "format_ref": "png_rgba",
      "own_dimensions_only": true,
      "dimensions": [
        {
          "name": "scope",
          "type": "regex",
          "default": "all",
          "regex": "^(all|project|whca)?$"
        },
        {
          "name": "project_countries",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z ,'-]*)$"
        },
        {
          "name": "country_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "region_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "district_name",
          "type": "regex",
