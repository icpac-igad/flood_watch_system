        },
        {
          "name": "country_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "region_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "district_name",
