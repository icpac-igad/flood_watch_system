      "source": "wrf_daily_rainfall_source",
      "format_ref": "png_rgba",
      "metatile": "1 1",
      "metadata": {
        "title": "WRF Daily Total Rainfall"
      }
    },
    {
      "name": "wrf_extreme_heavy",
      "source": "wrf_extreme_heavy_source",
      "format_ref": "png_rgba",
      "metatile": "1 1",
      "metadata": {
        "title": "WRF Heavy Rainfall"
      }
    },
    {
      "name": "wrf_extreme_very_heavy",
      "source": "wrf_extreme_very_heavy_source",
