      }
    },
    {
      "name": "asap_cropland",
      "source": "asap_cropland_source",
      "format_ref": "png_rgba",
      "own_dimensions_only": true,
      "dimensions": [
        {
          "name": "scope",
          "type": "regex",
          "default": "all",
          "regex": "^(all|project|whca)?$"
        },
        {
          "name": "project_countries",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z ,'-]*)$"
        },
        {
          "name": "country_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "region_name",
          "type": "regex",
          "default": "__none__",
          "regex": "^(__none__|[A-Za-z .,'-]*)$"
        },
        {
          "name": "district_name",
          "type": "regex",
