######## EAFW FLOODWATCH ENVIRONMENT TEMPLATE ########
# Copy this file to .env and set real credentials.
# Main local stack: docker compose up --build -d

######## DATABASE ########
CMS_DB_USER=geomanager
CMS_DB_NAME=geomanager_web
CMS_DB_PASSWORD=change-me
# Used by standalone scripts running from host machine
DATABASE_URL=postgis://geomanager:change-me@127.0.0.1:9060/geomanager_web
CMS_DB_VOLUME=./data/pgdata

######## CONTAINER NAMES ########
DB_CNTR_NAME=eafw-pgdb
PGBOUNCER_CNTR_NAME=eafw-pgbouncer
MEMCACHED_CNTR_NAME=eafw-memcached
WEB_CNTR_NAME=eafw-cms
MAPVIEWER_CNTR_NAME=eafw-mapviewer
MAPSERVER_CNTR_NAME=eafw-mapserver
MAPCACHE_CNTR_NAME=eafw-mapcache
TILESERV_CNTR_NAME=eafw-tileserv
NGINX_CNTR_NAME=eafw-nginx
API_CNTR_NAME=eafw-api
JOBS_CNTR_NAME=eafw-jobs

######## HOST / NETWORK ########
HOST_IP=127.0.0.1
RESTART_POLICY=unless-stopped

# Optional host port overrides
DB_HOST_PORT=9060
PGB_HOST_PORT=9061
CACHE_HOST_PORT=9062
WEB_HOST_PORT=9063
UI_HOST_PORT=9064
MS_HOST_PORT=9065
MC_HOST_PORT=9066
TILESERV_HOST_PORT=9067
CMS_HOST_PORT=9068
API_HOST_PORT=9069

######## CMS (GEOMANAGER) ########
DEBUG=True
CMS_DEBUG=True
CMS_SITE_NAME="East Africa Flood Watch (Local)"
ADMIN_URL_PATH=cms-admin
TIME_ZONE=Africa/Nairobi
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS="127.0.0.1,localhost"
CSRF_TRUSTED_ORIGINS="http://127.0.0.1:9068,http://localhost:9068"
CORS_ALLOWED_ORIGINS="http://127.0.0.1:9068,http://localhost:9068"
CMS_PORT=8000
CMS_BASE_URL="http://127.0.0.1:9068"
FORCE_SCRIPT_NAME=""
CMS_DEFAULT_LANGUAGE_CODE=en
DJANGO_SETTINGS_MODULE=geomanagerweb.settings.production

# CMS workers and file locations
CMS_NUM_OF_WORKERS=2
CMS_STATIC_VOLUME=./data/static
CMS_MEDIA_VOLUME=./data/media
GEOMANAGER_AUTO_INGEST_DATA_VOLUME=./data/geomanager-data
CMS_LOG_FILE=./logs/cms-web.log

# Optional CMS email settings
SMTP_EMAIL_HOST=
SMTP_EMAIL_PORT=
SMTP_EMAIL_USE_TLS=
SMTP_EMAIL_HOST_USER=
SMTP_EMAIL_HOST_PASSWORD=
CMS_ADMINS=
DEFAULT_FROM_EMAIL=

# Optional reCAPTCHA
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

######## MAPVIEWER ########
MAPVIEWER_CMS_API=/api
MAPVIEWER_SERVER_URL=http://eafw_mapviewer:3000
MAPVIEWER_BASE_PATH=/
MAPVIEWER_ASSET_PREFIX=
MAPVIEWER_NEXT_STATIC_VOLUME=./data/next
ADMIN_BOUNDARY_API=/api/admin-boundaries/

######## EAFW API ########
# Upstream CMS API used by /api/v1 mapviewer compatibility endpoints.
EAFW_CMS_API_BASE_URL=http://eafw_cms:8000/api

# Optional mapviewer integrations
ANALYTICS_PROPERTY_ID=
BITLY_TOKEN=
GOOGLE_CUSTOM_SEARCH_CX=
GOOGLE_SEARCH_API_KEY=

######## MAPSERVER / MAPCACHE ########
MS_MAPFILES_VOLUME=./data/mapfiles
MS_SERVICE_URL=http://127.0.0.1:9065/mapserver/
MC_TILES_DIR=./data/mapcache/tiles
MC_SERVICE_URL=http://127.0.0.1:9066/mapcache/

######## FLOODPROOFS SFTP (used by jobs) ########
FLOODPROOFS_SFTP_HOST=sftp.example.org
FLOODPROOFS_SFTP_PORT=22
FLOODPROOFS_SFTP_USER=change-me
FLOODPROOFS_SFTP_PASSWORD=change-me
FLOODPROOFS_REMOTE_DIR=/home/floodproofs/merged_forecasts

######## ENSEMBLE FTP (used by jobs) ########
ENSEMBLE_FTP_HOST=ftp.example.org
ENSEMBLE_FTP_PORT=21
ENSEMBLE_FTP_USER=change-me
ENSEMBLE_FTP_PASSWORD=change-me
ENSEMBLE_REMOTE_DIR=/ftproot/output/Combined

######## WRF RAINFALL FTP ########
WRF_FTP_HOST=ftp.example.org
WRF_FTP_PORT=21
WRF_FTP_USER=change-me
WRF_FTP_PASSWORD=change-me
WRF_REMOTE_DIR=/SharedData/wrf/weekly

######## GOOGLE DRIVE / SYNC ########
DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=./eafw_jobs/credentials/google-credentials.json
SYNC_SOURCE=drive
SYNC_INTERVAL=21600
SYNC_DAYS=7

######## GOOGLE FLOOD API (used by jobs) ########
FLOODS_API_KEY=
GOOGLE_FLOOD_REGION_CODES=ET,KE,UG,SD,SS,RW,SO,DJ,ER,TZ,BI
GOOGLE_FLOOD_PAGE_SIZE=20000
GOOGLE_FLOOD_STATUS_CHUNK_SIZE=500
GOOGLE_FLOOD_MODEL_CHUNK_SIZE=200
GOOGLE_FLOOD_FORECAST_CHUNK_SIZE=200
GOOGLE_FLOOD_ISSUED_LOOKBACK_DAYS=7
GOOGLE_FLOOD_INCLUDE_NON_QUALITY_VERIFIED=true
GOOGLE_FLOOD_INCLUDE_GAUGES_WITHOUT_HYDRO_MODEL=true
GOOGLE_FLOOD_REQUEST_TIMEOUT_SECONDS=120
GOOGLE_FLOOD_MAX_RETRIES=4
GOOGLE_FLOOD_BASE_BACKOFF_SECONDS=1.0

######## JOBS STORAGE (used by some compose variants) ########
JOBS_DATA_VOLUME=./eafw_jobs/data
JOBS_LOGS_VOLUME=./eafw_jobs/logs

######## LEGACY SCRIPT COMPATIBILITY (optional) ########
# scripts/ftp_sync.py and scripts/test_ensemble_ftp_sync.py
FTP_HOST=ftp.example.org
FTP_PORT=21
FTP_USER=change-me
FTP_PASSWORD=change-me
FTP_REMOTE_DIR=/ftproot/output/Combined
FTP_LOCAL_DIR=./downloaded_data

# Legacy floodproofs script variables
SFTP_HOST=sftp.example.org
SFTP_PORT=22
SFTP_USERNAME=change-me
SFTP_PASSWORD=change-me
