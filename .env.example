# ===========================================
# EAFW FloodWatch - Unified Environment Config
# ===========================================
# Copy to .env: cp .env.example .env
# Then fill in only the CREDENTIALS section below.
# Everything else auto-configures based on EAFW_ENV.
# ===========================================

# --- ENVIRONMENT (local | staging | production) ---
EAFW_ENV=local

# --- CREDENTIALS (the only section you must fill in) ---
# Database
CMS_DB_PASSWORD=localdevpassword

# Django secret (generate with: openssl rand -hex 50)
SECRET_KEY=local-dev-secret-key-not-for-production-use-only-12345

# FloodProofs SFTP
FLOODPROOFS_SFTP_HOST=197.254.113.173
FLOODPROOFS_SFTP_USER=floodproofs
FLOODPROOFS_SFTP_PASSWORD=

# Ensemble FTP
ENSEMBLE_FTP_HOST=
ENSEMBLE_FTP_USER=
ENSEMBLE_FTP_PASSWORD=
ENSEMBLE_FTP_DIR=

# WRF Rainfall FTP
WRF_FTP_HOST=
WRF_FTP_USER=
WRF_FTP_PASSWORD=
WRF_REMOTE_DIR=

# Google Drive Sync
DRIVE_FOLDER_ID=
SYNC_SOURCE=drive

# ===========================================
# AUTO-CONFIGURED (override only if needed)
# ===========================================

# Database
CMS_DB_USER=geomanager
CMS_DB_NAME=geomanager_web

# Ports (90xx series)
DB_HOST_PORT=9060
PGB_HOST_PORT=9061
CACHE_HOST_PORT=9062
WEB_HOST_PORT=9063
UI_HOST_PORT=9064
MS_HOST_PORT=9065
MC_HOST_PORT=9066
TILESERV_HOST_PORT=9067
CMS_HOST_PORT=9068
API_HOST_PORT=9069

# Timezone
TIME_ZONE=Africa/Nairobi

# Sync settings
FLOODPROOFS_SFTP_PORT=22
FLOODPROOFS_REMOTE_DIR=/home/floodproofs/merged_forecasts
ENSEMBLE_FTP_PORT=21
WRF_FTP_PORT=21
SYNC_INTERVAL=21600
SYNC_DAYS=7
GOOGLE_CREDENTIALS_FILE=./eafw_jobs/credentials/google-credentials.json
